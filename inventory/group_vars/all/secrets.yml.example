---
# Copy to secrets.yml and encrypt with:
#   cp inventory/group_vars/all/secrets.yml.example inventory/group_vars/all/secrets.yml
#   ansible-vault encrypt inventory/group_vars/all/secrets.yml
# Then fill in real values before encrypting. Never commit the plaintext file.

# Ansible inventory host connection
vault_ansible_host: "example-host"
vault_ansible_port: "22"
vault_ansible_user: "user"

vault_postgres_password: "change-me-postgres"
vault_redis_password: "change-me-redis"
vault_litellm_master_key: "sk-change-me-master-key"

vault_opencode_api_key: ""
vault_cline_api_key: ""
vault_commandcode_api_key: ""
vault_openrouter_api_key: ""
vault_exa_api_key: ""
vault_firecrawl_api_key: ""
vault_headroom_api_key: ""
vault_headroom_proxy_token: ""
vault_nanogpt_api_key: ""
vault_resend_api_key: ""
vault_context7_api_key: ""
vault_ollama_api_key: ""

vault_resend_from_email: "notify@fqdn"
vault_acme_email: "acme@fqdn"
vault_litellm_allowed_ips:
  - "127.0.0.1"
vault_litellm_domain: "fqdn"

vault_custom_coding_api_base: ""
vault_custom_agentic_api_base: ""
vault_custom_fast_api_base: ""
vault_custom_embedding_api_base: ""
