# LiteLLM proxy environment — mirrors beekube litellm.tf Helm envVars
STORE_MODEL_IN_DB=true
DEFAULT_MCP_SEMANTIC_FILTER_EMBEDDING_MODEL=embedding
DEFAULT_MCP_SEMANTIC_FILTER_MODEL=fast
LITELLM_MCP_TOOL_LISTING_TIMEOUT=60
DEFAULT_NUM_WORKERS_LITELLM_PROXY=4
NO_DOCS=true
NO_REDOC=true
NO_OPENAPI=true
USE_PRISMA_MIGRATE=true
LITELLM_HIDE_DEFAULT_CREDENTIALS_HINT=true
LITELLM_MODE=PRODUCTION
LITELLM_USER_AGENT=Bleenk/1.0.0
REDIS_CONNECTION_POOL_TIMEOUT=30
REDIS_SOCKET_TIMEOUT=10
LITELLM_LOG=INFO

# Database
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@postgres:5432/{{ postgres_db }}

# Redis (referenced via os.environ in config.yaml cache_params)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ redis_password }}

# Proxy master key (general_settings.master_key = os.environ/PROXY_MASTER_KEY)
PROXY_MASTER_KEY={{ litellm_master_key }}

# Provider API keys
OPENCODE_API_KEY={{ opencode_api_key }}
CLINE_API_KEY={{ cline_api_key }}
NANOGPT_API_KEY={{ nanogpt_api_key }}
OPENROUTER_API_KEY={{ openrouter_api_key }}
EXA_API_KEY={{ exa_api_key }}
FIRECRAWL_API_KEY={{ firecrawl_api_key }}
HEADROOM_API_KEY={{ headroom_api_key }}
CONTEXT7_API_KEY={{ context7_api_key }}

# Resend email notifications (resend_email callback)
RESEND_API_KEY={{ resend_api_key }}
RESEND_FROM_EMAIL={{ resend_from_email }}
PROXY_BASE_URL=https://{{ litellm_domain }}
