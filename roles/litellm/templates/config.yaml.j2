{# Per-model health probe caps. LiteLLM picks the 128/16 tier from its internal
   model registry only when the deployment string is listed there, so pin the
   tier per model_info to make it deterministic. -#}
{% set litellm_health_check_tokens = {
  'health_check_max_tokens_reasoning': 128,
  'health_check_max_tokens_non_reasoning': 16
} %}
{% macro litellm_model_info(model, provider) -%}
{{ litellm_model_costs[provider][model] | combine(litellm_model_caps[model]) | combine(litellm_health_check_tokens) | to_nice_yaml(indent=2, sort_keys=False) | indent(6, True) | regex_replace('\n\Z', '') }}
{%- endmacro %}
model_list:
  - model_name: openai/qwen3-embedding-0.6b
    model_info:
      max_input_tokens: 1024
      max_output_tokens: 1024
      max_tokens: 1024
      mode: embedding
      disable_background_health_check: true
    litellm_params:
      model: hosted_vllm/qwen3-embedding-0.6b
      api_key: no-api-key
      api_base: "{{ vault_custom_embedding_api_base }}"

  - model_name: coding
    model_info:
      max_input_tokens: 250000
      max_output_tokens: 32768
      max_tokens: 32768
      mode: chat
      supports_function_calling: true
      supports_reasoning: true
      supports_tool_choice: true
      supports_vision: false
      supports_prompt_caching: true
      disable_background_health_check: true
    litellm_params:
      model: hosted_vllm/qwen3.8
      api_key: no-api-key
      api_base: {{ vault_custom_coding_api_base }}
      temperature: 1.0
      presence_penalty: 0.0
      top_p: 0.95
      min_p: 0.0
      parallel_tool_calls: true
      repetition_penalty: 1.0
      extra_body:
        chat_template_kwargs:
          enable_thinking: true
          preserve_thinking: true
          reasoning_effort: xhigh
        top_k: 20
        options:
          num_ctx: 250000

  - model_name: agentic
    model_info:
      max_input_tokens: 250000
      max_output_tokens: 32768
      max_tokens: 32768
      mode: chat
      supports_function_calling: true
      supports_reasoning: true
      supports_tool_choice: true
      supports_vision: false
      supports_prompt_caching: true
      disable_background_health_check: true
    litellm_params:
      model: hosted_vllm/qwen3.8
      api_key: no-api-key
      api_base: {{ vault_custom_agentic_api_base }}
      temperature: 1.0
      presence_penalty: 0.0
      top_p: 0.95
      parallel_tool_calls: true
      min_p: 0.0
      repetition_penalty: 1.0
      extra_body:
        chat_template_kwargs:
          enable_thinking: true
          preserve_thinking: true
          reasoning_effort: low
        top_k: 20
        options:
          num_ctx: 250000

  - model_name: fast
