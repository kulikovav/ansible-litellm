---
{% macro litellm_model_info(model, provider, overrides={}) -%}
{{ litellm_model_costs[provider][model] | combine(litellm_model_caps[model]) | combine(litellm_health_check_tokens) | combine(overrides) | to_nice_yaml(indent=2, sort_keys=False) | indent(6, True) | regex_replace('\n\Z', '') }}
{%- endmacro %}
model_list:
{% set opencode_go_headers = {'extra_headers': {'x-opencode-session': opencode_session_id}} %}
{% for entry in litellm_model_list %}
  - model_name: {{ entry.model_name }}
{% if entry.costs_provider is defined %}
    model_info:
{{ litellm_model_info(entry.model_name, entry.costs_provider, entry.model_info | default({})) }}
{% elif entry.model_info is defined %}
    model_info:
{{ entry.model_info | to_nice_yaml(indent=2, sort_keys=False) | indent(6, True) | regex_replace('\n\Z', '') }}
{% endif %}
{% set params = entry.litellm_params %}
{% if entry.litellm_params.api_base is defined and 'opencode.ai/zen/go' in entry.litellm_params.api_base %}{% set params = params | combine(opencode_go_headers) %}{% endif %}
    litellm_params:
{{ params | to_nice_yaml(indent=2, sort_keys=False) | indent(6, True) | regex_replace('\n\Z', '') }}
{% endfor %}

{% if headroom_enabled | bool %}
guardrails:
  - guardrail_name: headroom-compression
    litellm_params:
      guardrail: headroom
      mode: pre_call
      api_base: "{{ litellm_headroom_api_base }}"
      api_key: os.environ/HEADROOM_API_KEY
      default_on: false

{% endif %}
rate_limit:
  enabled: false

general_settings:
  modify_params: true
  proxy_batch_write_at: {{ litellm_proxy_batch_write_interval }}
  database_connection_pool_limit: {{ litellm_db_connection_pool_limit }}
  allow_requests_on_db_unavailable: true
  disable_error_logs: true
  disable_env_credential_login: true
  master_key: os.environ/PROXY_MASTER_KEY
  background_health_checks: false
  health_check_interval: 7200
  store_prompts_in_spend_logs: true
  store_model_in_db: true

litellm_settings:
  drop_params: true
  enable_redis_auth_cache: true
  always_include_stream_usage: false
  request_timeout: {{ litellm_request_timeout }}
  json_logs: true
  cache: true
  stream: true
  cache_params:
    type: redis
    ttl: {{ litellm_cache_ttl }}
    host: os.environ/REDIS_HOST
    port: os.environ/REDIS_PORT
    password: os.environ/REDIS_PASSWORD
    namespace: litellm.caching.caching
    supported_call_types:
      - acompletion
      - atext_completion
      - aresponses
      - atranscription
  callbacks:
    - websearch_interception
    - resend_email
  websearch_interception_params:
    enabled_providers:
      - openai
      - anthropic
    search_tool_name: exa_search

search_tools:
  - search_tool_name: exa_search
    litellm_params:
      search_provider: exa_ai
      api_key: os.environ/EXA_API_KEY
  - search_tool_name: firecrawl_search
    litellm_params:
      search_provider: firecrawl
      api_key: os.environ/FIRECRAWL_API_KEY

mcp_servers:
  context7_mcp:
    url: https://mcp.context7.com/mcp
    transport: http
    auth_type: bearer_token
    auth_value: os.environ/CONTEXT7_API_KEY
  firecrawl_mcp:
    url: https://mcp.firecrawl.dev/v2/mcp
    transport: http
    auth_type: bearer_token
    auth_value: os.environ/FIRECRAWL_API_KEY
  exa_mcp:
    url: https://mcp.exa.ai/mcp
    transport: http
    auth_type: api_key
    auth_value: os.environ/EXA_API_KEY

router_settings:
  routing_strategy: simple-shuffle
  fallbacks:
    - agentic:
        - deepseek-v4.1-flash
    - coding:
        - glm-5.3-flash
    - fast:
        - deepseek-v4.1-flash
  enable_pre_call_checks: true
  num_retries: 1
  retry_after: 600
  timeout: 30
  allowed_fails: 1
  cooldown_time: 300
  context_window_fallbacks:
    - agentic:
        - deepseek-v4.1-flash
    - fast:
        - deepseek-v4.1-flash
  model_group_alias:
    embedding: openai/qwen3-embedding-0.6b
