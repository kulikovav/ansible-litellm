guardrails:
  - guardrail_name: headroom-compression
    litellm_params:
      guardrail: headroom
      mode: pre_call
      api_base: "{{ litellm_headroom_api_base }}"
      api_key: os.environ/HEADROOM_API_KEY
      default_on: true

rate_limit:
  enabled: false

general_settings:
  modify_params: true
  proxy_batch_write_at: {{ litellm_proxy_batch_write_interval }}
  database_connection_pool_limit: {{ litellm_db_connection_pool_limit }}
  allow_requests_on_db_unavailable: true
  disable_error_logs: true
  master_key: os.environ/PROXY_MASTER_KEY
  background_health_checks: true
  health_check_interval: 3600
  store_prompts_in_spend_logs: true
  store_model_in_db: true

litellm_settings:
  drop_params: true
  enable_redis_auth_cache: true
  always_include_stream_usage: false
  request_timeout: {{ litellm_request_timeout }}
  json_logs: true
  cache: true
  stream: true
  cache_params:
    type: redis
    ttl: {{ litellm_cache_ttl }}
    host: os.environ/REDIS_HOST
    port: os.environ/REDIS_PORT
    password: os.environ/REDIS_PASSWORD
    namespace: litellm.caching.caching
    supported_call_types:
      - acompletion
      - atext_completion
      - aresponses
      - atranscription
  callbacks:
    - websearch_interception
    - resend_email
  websearch_interception_params:
    enabled_providers:
      - openai
      - anthropic
    search_tool_name: exa_search

search_tools:
  - search_tool_name: exa_search
    litellm_params:
      search_provider: exa_ai
      api_key: os.environ/EXA_API_KEY
  - search_tool_name: firecrawl_search
    litellm_params:
      search_provider: firecrawl
      api_key: os.environ/FIRECRAWL_API_KEY

mcp_servers:
  context7_mcp:
    url: https://mcp.context7.com/mcp
    transport: http
    auth_type: bearer_token
    auth_value: os.environ/CONTEXT7_API_KEY
  firecrawl_mcp:
    url: https://mcp.firecrawl.dev/v2/mcp
    transport: http
    auth_type: bearer_token
    auth_value: os.environ/FIRECRAWL_API_KEY
  exa_mcp:
    url: https://mcp.exa.ai/mcp
    transport: http
    auth_type: api_key
    auth_value: os.environ/EXA_API_KEY

router_settings:
  routing_strategy: simple-shuffle
  routing_groups:
    - group_name: deepseek-v4-pro-group
      models: [deepseek-v4-pro]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: deepseek-v4-flash-group
      models: [deepseek-v4-flash]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: glm-5.2-group
      models: [glm-5.2]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: kimi-k2.7-code-group
      models: [kimi-k2.7-code]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: kimi-k3-group
      models: [kimi-k3]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: mimo-v2.5-group
      models: [mimo-v2.5]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: mimo-v2.5-pro-group
      models: [mimo-v2.5-pro]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: minimax-m3-group
      models: [minimax-m3]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
    - group_name: qwen3.8-max-group
      models: [qwen3.8-max]
      routing_strategy: latency-based-routing
      routing_strategy_args:
        ttl: 300
        lowest_latency_buffer: 0.5
  fallbacks:
    - openai/gemma-4-12B-it:
        - deepseek-v4-flash
    - agentic:
        - deepseek-v4-flash
    - coding:
        - kimi-k3
    - fast:
        - deepseek-v4-flash
  enable_pre_call_checks: true
  num_retries: 1
  retry_after: 600
  timeout: 30
  allowed_fails: 1
  cooldown_time: 300
  context_window_fallbacks:
    - agentic:
        - deepseek-v4-flash
    - coding:
        - kimi-k3
    - fast:
        - deepseek-v4-flash
  model_group_alias:
    embedding: openai/qwen3-embedding-0.6b
